{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nookits",
  "version": "0.1.0",
  "identifier": "com.nookits.app",
  "build": {
    "frontendDist": "generated/frontend",
    "additionalWatchFolders": ["../scripts/runtime.mjs", "../locales", "../assets/icon.svg", "../assets/example"]
  },
  "app": {
    "windows": [],
    "security": { "csp": "default-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "shortDescription": "Your scripts, one click away.",
    "publisher": "Github@ZhonFortune",
    "icon": ["generated/icons/icon.ico"],
    "externalBin": ["binaries/nookits-node"],
    "windows": {
      "wix": {
        "template": "installer/main.wxs",
        "fragmentPaths": ["generated/installer/uninstall.wxs"],
        "componentRefs": ["NookitsUserDataCleanup", "NookitsUninstallEntry"],
        "language": {
          "en-US": { "localePath": "generated/installer/en-US.wxl" }
        }
      }
    },
    "resources": {
      "generated/runtime/": "runtime/",
      "../assets/example/": "examples/"
    }
  }
}
